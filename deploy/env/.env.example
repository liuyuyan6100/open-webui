# Open WebUI 生产环境变量示例
# 使用方式：cp deploy/env/.env.example deploy/env/.env.prod，然后只修改 .env.prod。
# 注意：.env.prod 不应提交到 Git。

# 镜像版本。生产建议使用明确版本 tag，不建议长期使用 main。
APP_IMAGE=ghcr.io/open-webui/open-webui:v0.9.2

# 宿主机暴露端口。容器内 Open WebUI 固定监听 8080。
OPEN_WEBUI_PORT=3000

# 数据卷名称。默认使用 Docker named volume，避免相对路径导致权限问题。
OPEN_WEBUI_VOLUME=open-webui-data

# Open WebUI 基础配置
WEBUI_NAME=My AI WebUI
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# Ollama。如不使用 Ollama，可留空或指向实际 Ollama 地址。
# Docker Desktop/本机服务常用：http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI Compatible API。可指向 OpenAI、网关、本地兼容接口等。
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me

# 反代场景建议显式配置
FORWARDED_ALLOW_IPS=*
CORS_ALLOW_ORIGIN=*

# 关闭遥测/追踪
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
